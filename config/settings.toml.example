# settings.toml.example
# このファイルをコピーして config/settings.toml として使用してください。
# settings.toml は .gitignore 対象です（機器固有値を含むため）。

[serial]
# アクチュエータ用 USB-RS485 デバイスパス。
# USB 列挙順 (ttyUSBn) は接続順・再起動で変わりうる（UPS シリアル等と衝突する）ため、
# scripts/setup_udev.sh で FTDI シリアル番号に基づく固定シンボリックリンクを設置し、
# 以下の /dev/actuator_* を使うことを推奨する（直接 /dev/ttyUSBn も指定可）。
#   確認: scripts/setup_udev.sh --list
#   設置: sudo scripts/setup_udev.sh <accel_serial> <brake_serial>
# アクセルアクチュエータ
accel_port = "/dev/actuator_accel"
# ブレーキアクチュエータ
brake_port = "/dev/actuator_brake"
# Modbus RTU ボーレート（P-CON-CB 実機確認値）
baud_rate = 38400

[can]
# python-can インターフェース名
interface = "kvaser"
# Kvaser USB-CAN チャンネル番号
channel = 0
# CAN バス通信速度 [bps]（シャシダイナモ送信側と合わせること）
bitrate = 500000
# DBC ファイルパス（シャシダイナモ車速デコード用）
dbc_path = "config/can/MEIDEN_MEIDACS.dbc"

[database]
# asyncpg 接続文字列
dsn = "postgresql://localhost/driving_robot"

[gpio]
# AC断検知ピン（BCM番号）
# APC Smart-UPS 750 はシリアル経由の NUT で AC断を検知するため、このピンは使用しない。
# 別機種で接点出力を使う場合に設定する（factory.py の GPIOMonitor に渡されるが登録されない）
ac_detect_pin = 27
# 非常停止スイッチ入力ピン（BCM番号、物理ピン11）
emergency_stop_pin = 17

[ups]
# NUT (Network UPS Tools) サーバーのホスト名
# 通常は localhost（Raspberry Pi 上で upsd を実行）
nut_host = "localhost"
# NUT サーバーのポート番号（デフォルト 3493）
nut_port = 3493
# NUT での UPS 名（/etc/nut/ups.conf の [] 内の名前と一致させること）
ups_name = "apcups"
# バッテリー状態ポーリング間隔 [s]（AC断検知の応答時間に影響）
poll_interval_s = 5.0

[archive]
# アーカイブ先 USB SSD のマウントパス
usb_ssd_path = "/mnt/usb_ssd/archive"
# アクティブログの保持日数（これを超えたセッションがアーカイブ対象）
active_log_days = 90
# 内蔵SSD / USB SSD 使用率の閾値 [%]（これを超えるとアーカイブ実行）
storage_limit_pct = 80

[control]
# 制御ループ周期 [ms]
loop_interval_ms = 50
# ログ書き込み周期 [ms]
log_interval_ms = 100

[safety]
# 走行中の過電流検知閾値 [mA]（P-CON-CB 仕様から設定）
overcurrent_limit_ma = 3000

[model]
# 先読み逆モデルの特徴量構成（FeatureSpec）。デフォルトは現行9特徴と完全一致する。
# 値の変更は `scripts/evaluate_feature_sets.py` によるオフライン評価の結果を
# 確認してから行うこと（.steering/20260703-learning-process-revamp/design.md 参照）。
lookahead_horizons_s = [0.5, 1.0, 2.0, 3.0]
past_horizons_s = [0.5, 1.0]
regime_horizon_s = 1.0
include_v0_sq = true
include_dv_regime_x_v0 = true
accel_horizons_s = []

[learning]
# 2段階学習フロー（学習サイクル）の各段の PID 適合走行回数上限
# stage1 は kp/ki/kd に加え先読み補償秒数(preview_time_s)も探索する4次元座標降下のため
# 10→14 に増やしている（1巡=最大8走行、ベースライン+1巡強を確保）。
refine_runs_stage1 = 14
refine_runs_stage2 = 5
# 学習運転（開ループパターン走行）完了待ちのタイムアウト [s]
learning_timeout_s = 600.0
