# settings.toml.example
# このファイルをコピーして config/settings.toml として使用してください。
# settings.toml は .gitignore 対象です（機器固有値を含むため）。

[serial]
# アクチュエータ用 USB-RS485 デバイスパス。
# USB 列挙順 (ttyUSBn) は接続順・再起動で変わりうる（UPS シリアル等と衝突する）ため、
# scripts/setup_udev.sh で FTDI シリアル番号に基づく固定シンボリックリンクを設置し、
# 以下の /dev/actuator_* を使うことを推奨する（直接 /dev/ttyUSBn も指定可）。
#   確認: scripts/setup_udev.sh --list
#   設置: sudo scripts/setup_udev.sh <accel_serial> <brake_serial>
# アクセルアクチュエータ
accel_port = "/dev/actuator_accel"
# ブレーキアクチュエータ
brake_port = "/dev/actuator_brake"
# Modbus RTU ボーレート（P-CON-CB 実機確認値）
# 仕様上は 230400 まで選択可（MODBUS 2-1）。38400 は PCON-CB の工場出荷時既定値。
baud_rate = 38400
# Modbus 応答待ち [s]。仕様式（MODBUS 4-2）では 38400bps で約 12.4ms。
# 4 試行の合計が base_loop.WEDGED_CYCLE_TIMEOUT_S=1.0s を超えないこと
# （旧既定 0.3s は 4 試行 1.2s で、再送上限到達が必ず非常停止を起こしていた）。
timeout_s = 0.05
# 再送回数（MODBUS 4-2「リトライは、必ず設定してください」Nrt=3）
retries = 3

# ── アクチュエータ機体仕様（docs/manuals/RCP6-ROD(MJ3751-2Q).pdf より） ──────────
# 最高速度・最低速度・加減速度別可搬質量は**すべてリード長に依存する**ため、実機ラベルの
# 型式を型番展開してここに記録する。型式の読み方（MJ3751-2Q 1.1 型式構成）:
#   RCP6 - RA6R - WA - 42P - 6 - 100 - P3 - M - MT
#   シリーズ  タイプ  エンコーダー  モーター  リード  ストローク  コントローラー  ケーブル  オプション
#   RA6R/RA7R = ロッドタイプ・モーター折返し / WA = バッテリーレスアブソ
#   42P/56P = モーター 42□/56□ / P3 = PCON-CB / M = ケーブル 5m
#   MT = モーター上折返し, ML = モーター左折返し
#
# min_speed（＝ lead_mm ÷ 0.8）はコード側で算出する（infra/actuator_driver.min_speed_for_lead）。
# 仕様の注意書き:「最低速度以下の速度は設定しないでください。設定した速度では動きません」
#
# max_speed_mm_s は「速度の制限」表（1.2.1・モーター折返しタイプ）の**高出力設定無効時**の
# 値を入れている。高出力設定は PCON-CB パラメーター No.152 で、出荷時は**有効**（有効時は
# accel 450 / brake 水平420・垂直350 mm/s）。無効側の値にしておけば設定によらず安全側。
#
# max_accel_g は「加減速度別可搬質量」表（1.2.2）の運用速度域で十分な可搬質量が残る値。
# 100mm/s では accel 0.3G→40kg / brake 0.3G→50kg（高出力設定無効・水平）。
# 注意:「加減速度は、許容値以上の設定は行わないでください」

[actuator.accel]
# アクセルペダル用
model = "RCP6-RA6R-WA-42P-6-100-P3-M-MT"
lead_mm = 6.0        # → 最低速度 7.5 mm/s
stroke_mm = 100.0
max_speed_mm_s = 250.0  # 高出力設定無効時（有効時は 450）
max_accel_g = 0.3

[actuator.brake]
# ブレーキペダル用
model = "RCP6-RA7R-WA-56P-8-100-P3-M-ML"
lead_mm = 8.0        # → 最低速度 10.0 mm/s
stroke_mm = 100.0
max_speed_mm_s = 210.0  # 高出力設定無効時（有効時は 水平420 / 垂直350）
max_accel_g = 0.3

[can]
# python-can インターフェース名
interface = "kvaser"
# Kvaser USB-CAN チャンネル番号
channel = 0
# CAN バス通信速度 [bps]（シャシダイナモ送信側と合わせること）
bitrate = 500000
# DBC ファイルパス（シャシダイナモ車速デコード用）
dbc_path = "config/can/MEIDEN_MEIDACS.dbc"

[database]
# asyncpg 接続文字列
dsn = "postgresql://localhost/driving_robot"

[gpio]
# AC断検知ピン（BCM番号）
# APC Smart-UPS 750 はシリアル経由の NUT で AC断を検知するため、このピンは使用しない。
# 別機種で接点出力を使う場合に設定する（factory.py の GPIOMonitor に渡されるが登録されない）
ac_detect_pin = 27
# 非常停止スイッチ入力ピン（BCM番号、物理ピン11）
emergency_stop_pin = 17

[ups]
# NUT (Network UPS Tools) サーバーのホスト名
# 通常は localhost（Raspberry Pi 上で upsd を実行）
nut_host = "localhost"
# NUT サーバーのポート番号（デフォルト 3493）
nut_port = 3493
# NUT での UPS 名（/etc/nut/ups.conf の [] 内の名前と一致させること）
ups_name = "apcups"
# バッテリー状態ポーリング間隔 [s]（AC断検知の応答時間に影響）
poll_interval_s = 5.0

[archive]
# アーカイブ先 USB SSD のマウントパス
usb_ssd_path = "/mnt/usb_ssd/archive"
# アクティブログの保持日数（これを超えたセッションがアーカイブ対象）
active_log_days = 90
# 内蔵SSD / USB SSD 使用率の閾値 [%]（これを超えるとアーカイブ実行）
storage_limit_pct = 80

[control]
# 制御ループ周期 [ms]
loop_interval_ms = 50
# ログ書き込み周期 [ms]
log_interval_ms = 100

[safety]
# 走行中の過電流検知閾値 [mA]（P-CON-CB 仕様から設定）
overcurrent_limit_ma = 3000

[model]
# 先読み逆モデルの特徴量構成（FeatureSpec）。デフォルトは現行9特徴と完全一致する。
# 値の変更は `scripts/evaluate_feature_sets.py` によるオフライン評価の結果を
# 確認してから行うこと（.steering/20260703-learning-process-revamp/design.md 参照）。
lookahead_horizons_s = [0.5, 1.0, 2.0, 3.0]
past_horizons_s = [0.5, 1.0]
regime_horizon_s = 1.0
include_v0_sq = true
include_dv_regime_x_v0 = true
accel_horizons_s = []

[learning]
# 学習サイクル（学習運転→訓練→PID粗適合→再学習→プラン学習→PID仕上げ）のフェーズ別パラメータ。
# 2026-09-08 ProblemReport_20260908 対応: 34.2分→20分以内の時間短縮と KPI 未達の是正で
# src/infra/settings.py の LearningSettings 既定値と揃えた（旧 refine_runs_stage2 /
# tuning_on_target_mode は廃止済みフィールドで、指定しても読み捨てられる）。

# REFINE_1（PID 粗適合）の走行本数。REFINE_F 廃止に伴い粗適合はゲイン概算のみでよいため 2。
refine_runs_stage1 = 2
# VERIFY フェーズ（網羅検証パターンでの走行）の走行本数。0 でフェーズ廃止（PLAN_LEARN
# 初回走行が実質の初回検証を兼ねる）。
verify_runs = 0
# 網羅検証パターン（システムモード）の目標長 [s]。PLAN_LEARN で使う。
verify_pattern_budget_s = 130.0
# PLAN_LEARN フェーズ（KPI 未達でも無条件実行）の最大走行本数。0 でフェーズスキップ。
# 最終結果は本数内の best 走行を採用する（learning_cycle.py）。
plan_learn_runs_max = 4
# PLAN_LEARN 早期打ち切りの reward 改善幅しきい値。
plan_learn_reward_epsilon = 1.0
# REFINE_F（PID 仕上げ・収束プラン凍結の座標降下）の走行本数。0 でフェーズ廃止。
refine_final_runs = 0
# 学習運転（開ループパターン走行）完了待ちのタイムアウト [s]
learning_timeout_s = 900.0
